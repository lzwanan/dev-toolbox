{
  "name": "dev-toolbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "一个简洁优雅的在线程序员工具箱",
  "author": "lzwanan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lzwanan/dev-toolbox.git"
  },
  "keywords": [
    "devtools",
    "toolbox",
    "json",
    "mbti",
    "developer-tools",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker build -t dev-toolbox .",
    "docker:run": "docker run -d -p 3000:80 --name dev-toolbox dev-toolbox",
    "docker:stop": "docker stop dev-toolbox && docker rm dev-toolbox"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
